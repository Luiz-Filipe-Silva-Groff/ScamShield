# DEMO: credencial pública de teste, sem acesso a serviços externos.
SCAMSHIELD_MODE=demo
SCAMSHIELD_API_KEYS='{"demo":"scamshield-demo-local"}'

# Para LIVE, troque o modo e configure uma chave aleatória própria (>=24 caracteres).
# SCAMSHIELD_API_KEYS='{"banco-exemplo":"SUBSTITUA_POR_UMA_CHAVE_ALEATORIA"}'
SCAMSHIELD_GEMINI_API_KEY=
# Modelo configurável; exemplo presente na documentação consultada em 14/09/2026.
SCAMSHIELD_GEMINI_MODEL=gemini-3.8-flash
SCAMSHIELD_READER_TIMEOUT=2.8
SCAMSHIELD_REGISTRY_TIMEOUT=1.2
SCAMSHIELD_ANALYSIS_TIMEOUT=4.5
SCAMSHIELD_UPLOAD_TIMEOUT=15
SCAMSHIELD_RATE_LIMIT=30
SCAMSHIELD_RATE_WINDOW=60
SCAMSHIELD_MAX_CONCURRENT=8
